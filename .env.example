# Copy to .env (or export these). Everything is optional: with no keys at all,
# Local Perplex runs fully locally on Ollama + DuckDuckGo.
LOCAL_PERPLEX_PROVIDER=ollama          # see `perplex --list-providers`
LOCAL_PERPLEX_MODEL=llama3.2:3b
LOCAL_PERPLEX_SEARCH=duckduckgo        # duckduckgo | searxng | brave | tavily | serper | wikipedia | arxiv
# OLLAMA_HOST=http://localhost:11434

# Hosted LLMs (only the one you use)
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=
# MISTRAL_API_KEY=
# DEEPSEEK_API_KEY=
# OPENROUTER_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# XAI_API_KEY=
# PERPLEXITY_API_KEY=
# CEREBRAS_API_KEY=
# COHERE_API_KEY=
# HF_TOKEN=
# NVIDIA_API_KEY=
# SAMBANOVA_API_KEY=
# DEEPINFRA_API_KEY=

# Search APIs
# SEARXNG_URL=http://localhost:8888
# BRAVE_API_KEY=
# TAVILY_API_KEY=
# SERPER_API_KEY=
